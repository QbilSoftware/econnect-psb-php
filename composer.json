{
    "name": "qbil-software/econnect-psb-php",
    "description": "PHP SDK for the eConnect Procurement Service Bus (PSB) API",
    "type": "library",
    "keywords": [
        "econnect",
        "psb",
        "peppol",
        "e-invoicing",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api",
        "symfony"
    ],
    "homepage": "https://github.com/QbilSoftware/econnect-psb-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Qbil Software",
            "homepage": "https://www.qbilsoftware.com"
        },
        {
            "name": "OpenAPI-Generator contributors",
            "homepage": "https://openapi-generator.tech"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/psr7": "^2.12.3 || ^3.0",
        "php-http/async-client-implementation": "^1.0",
        "php-http/client-common": "^2.4",
        "php-http/discovery": "^1.15",
        "php-http/httplug": "^2.2",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "symfony/clock": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.7",
        "guzzlehttp/promises": "^2.0 || ^3.0",
        "php-http/mock-client": "^1.6",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": { "EConnect\\Psb\\" : "lib/" },
        "files": ["lib/functions.php"]
    },
    "autoload-dev": {
        "psr-4": { "EConnect\\Psb\\Test\\" : "test/" }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
